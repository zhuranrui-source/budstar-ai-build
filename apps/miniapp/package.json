{
  "name": "@budstar/miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "BudStar 家庭视图微信小程序（Taro + React，ADR-0006/0007）",
  "scripts": {
    "build:weapp": "taro build --type weapp",
