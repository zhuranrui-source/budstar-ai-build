PORT=3001
# 生产域名拓扑：budstar-ai.site(官网) / api.budstar-ai.site(后端) / admin.budstar-ai.site(后台+合作方门户)
# 生产：CORS_ORIGINS=https://budstar-ai.site,https://admin.budstar-ai.site,https://api.budstar-ai.site + 本地开发源
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Local/test default. Production defaults to prisma when unset.
APPOINTMENT_LEAD_REPOSITORY=memory
DATABASE_URL=postgresql://budstar:change-me@localhost:5432/budstar

# Local/test authentication adapters only.
LOCAL_VERIFICATION_CODE=000000
LOCAL_SECOND_FACTOR_CODE=000000
