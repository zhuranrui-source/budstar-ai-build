# API
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
REQUEST_BODY_LIMIT=32kb
# Local/test only. Production defaults to prisma when this is unset.
APPOINTMENT_LEAD_REPOSITORY=memory
# Local/test only. Production defaults to a PostgreSQL-backed limiter.
APPOINTMENT_RATE_LIMIT_STORE=memory
APPOINTMENT_RATE_LIMIT_MAX=5
APPOINTMENT_RATE_LIMIT_WINDOW_MS=60000
DATABASE_URL=postgresql://budstar:change-me@localhost:5432/budstar
# Local/test adapters only; do not use these adapters in production.
LOCAL_VERIFICATION_CODE=000000
LOCAL_SECOND_FACTOR_CODE=000000
# Optional. When unset in non-production, API loads default fixtures:
# student@local / Student123! · staff@local / Password123! · platform@local / Platform123!
# Parent OTP: any 1xxxxxxxxxx phone + LOCAL_VERIFICATION_CODE (e.g. 13800138000 / 000000)
# LOCAL_AUTH_ACCOUNTS_JSON=

# Object storage: local | cos (production COS missing config fails closed)
OBJECT_STORAGE_PROVIDER=local

# AI teacher gateway: mock | remote (production remote missing config fails closed)
AI_GATEWAY_PROVIDER=mock
# AI_PRIMARY_API_KEY=
# AI_PRIMARY_ENDPOINT=
# AI_FALLBACK_API_KEY=
# AI_FALLBACK_ENDPOINT=

# Optional memory stores for local/tests only (production requires DATABASE_URL)
# FEEDBACK_STORE=memory
# COMMUNITY_STORE=memory
# PLATFORM_DATA_STORE=memory

# consumer-web (browser-visible configuration only)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

